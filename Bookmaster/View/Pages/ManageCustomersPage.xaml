<Page x:Class="Bookmaster.View.Pages.ManageCustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bookmaster.View.Pages"
      mc:Ignorable="d" 
     d:DesignHeight="964" d:DesignWidth="1880"
      Title="ManageCustomersPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!--Панель поиска-->
        <Border Background="{DynamicResource Gray}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="1" Text="Уникальный код"/>
                <TextBox Name="CustomerIdTb" Grid.ColumnSpan="3" Grid.Row="3"/>

                <TextBlock Grid.Row="5" Text="Имя читателя"/>
                <TextBox Name="NameTb" Grid.ColumnSpan="3" Grid.Row="7"/>


                <Button Name="SearchCustomerBtn" Grid.Row="9" Grid.ColumnSpan="3" Content="🔍 Поиск" Click="SearchCustomerBtn_Click"/>

                <Button Name="AddCustomerBtn" Grid.Row="11" Grid.Column="2" Content="Добавить" Click="AddCustomerBtn_Click"/>

                <Button Name="EditCustomerBtn" Grid.Row="11"  Content="Редактировать" Click="EditCustomerBtn_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Column="2" Margin="0 20 20 20">

            <Grid>
                <ListView Name="CustomersLV" SelectionChanged="CustomersLV_SelectionChanged">
                    <!--Создаем заголовки для таблицы-->
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Уникальный код" DisplayMemberBinding="{Binding Id}"/>

                            <GridViewColumn Header="ФИО" DisplayMemberBinding="{Binding Name}"/>

                            <GridViewColumn Header="Адресс" DisplayMemberBinding="{Binding Address}"/>

                            <GridViewColumn Header="Индекс" DisplayMemberBinding="{Binding Zip}"/>

                            <GridViewColumn Header="Город" DisplayMemberBinding="{Binding City.Name}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
